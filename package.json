{
  "name": "renpho-health-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server exposing Renpho smart-scale body-composition data — weight, body fat, muscle, water, bone, BMR, visceral fat and more — to Claude for training coaching.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "icon": "node scripts/make-icon.mjs",
    "icon:embed": "node scripts/embed-icon.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.0.5",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "aes-js": "^3.1.2",
    "agents": "^0.0.80",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@types/aes-js": "^3.1.4",
    "@types/node": "^22.20.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8",
    "wrangler": "~4.99.0"
  }
}
